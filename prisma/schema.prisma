generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum PlanType {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum BillingProvider {
  FLOW
}

enum BillingSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum TemplateType {
  SYSTEM
  USER
}

enum TemplateSectionType {
  HEADER
  SUBTITLE
  CLIENT
  EVENT
  TABLE
  TOTALS
  TERMS
  PAYMENT
  CONTACT
}

enum TemplateItemType {
  TEXT
  FIELD
  TABLE_COLUMN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  name                String?
  mustChangePassword  Boolean            @default(false)
  tokenVersion        Int                @default(0)
  onboardingCompleted Boolean            @default(false)
  dashboardOnboardingSeenAt DateTime?
  plan                PlanType           @default(FREE)
  subscriptionStatus  SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd    DateTime?
  workspaceId         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace                   Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  ownedWorkspaces             Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers            WorkspaceMember[]
  invitedWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInvitedBy")

  senderProfile       SenderProfile?
  services            Service[]
  categories          Category[]
  templates           Template[]
  quotes              Quote[]
  createdQuoteFolders QuoteFolder[]  @relation("QuoteFolderCreatedBy")
  createdFrequentClients FrequentClient[] @relation("FrequentClientCreatedBy")
  quoteFavorites      QuoteFavorite[]

  @@index([workspaceId])
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  users       User[]
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]

  senderProfiles      SenderProfile[]
  services            Service[]
  categories          Category[]
  templates           Template[]
  quotes              Quote[]
  quoteFavorites      QuoteFavorite[]
  quoteFolders        QuoteFolder[]
  billingSubscription BillingSubscription?
  billingEvents       BillingEvent[]
  frequentClients     FrequentClient[]

  @@index([ownerId])
}

model FrequentClient {
  id              String   @id @default(uuid())
  workspaceId     String
  createdByUserId String?
  label           String
  name            String
  rut             String?
  giro            String?
  email           String
  address         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("FrequentClientCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, label])
  @@index([workspaceId])
  @@index([createdByUserId])
}

model BillingSubscription {
  id                     String                    @id @default(uuid())
  workspaceId            String                    @unique
  provider               BillingProvider           @default(FLOW)
  providerCustomerId     String?
  providerSubscriptionId String?                   @unique
  providerPlanId         String?
  plan                   PlanType                  @default(FREE)
  status                 BillingSubscriptionStatus @default(PENDING)
  currency               String                    @default("CLP")
  monthlyAmount          Int                       @default(0)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  gracePeriodEnd         DateTime?
  cancelAtPeriodEnd      Boolean                   @default(false)
  canceledAt             DateTime?
  lastInvoiceId          String?
  lastPaymentAt          DateTime?
  metadata               Json?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([provider, providerCustomerId])
  @@index([status, gracePeriodEnd])
}

model BillingCheckoutSession {
  id                 String          @id @default(uuid())
  workspaceId        String
  userId             String
  provider           BillingProvider @default(FLOW)
  providerCustomerId String?
  token              String?
  targetPlan         PlanType
  providerPlanId     String
  currency           String          @default("CLP")
  monthlyAmount      Int
  status             String          @default("PENDING")
  expiresAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([workspaceId])
  @@index([token])
  @@index([status, expiresAt])
}

model BillingEvent {
  id              String             @id @default(uuid())
  workspaceId     String?
  provider        BillingProvider    @default(FLOW)
  providerEventId String             @unique
  type            String
  status          BillingEventStatus @default(PENDING)
  payload         Json
  error           String?
  processedAt     DateTime?
  createdAt       DateTime           @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status, createdAt])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String        @id @default(uuid())
  workspaceId     String
  email           String
  role            WorkspaceRole
  token           String        @unique
  invitedByUserId String?
  acceptedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([workspaceId, email])
}

model SenderProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  workspaceId  String?
  displayName  String
  contactEmail String
  contactPhone String?
  address      String?
  addressLine  String?
  city         String?
  commune      String?
  logoUrl      String?
  legalName    String?
  rut          String?
  giro         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Service {
  id            String   @id @default(uuid())
  userId        String
  workspaceId   String?
  inventoryCode String
  name          String
  description   String?
  categoryId    String?
  unitPrice     Decimal  @db.Decimal(12, 2)
  quantity      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace  Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quoteItems QuoteItem[]

  @@unique([userId, inventoryCode])
  @@unique([workspaceId, inventoryCode])
  @@index([userId])
  @@index([workspaceId])
  @@index([categoryId])
}

model Category {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  services  Service[]

  @@index([userId])
  @@index([workspaceId])
}

model Template {
  id          String       @id @default(uuid())
  userId      String?
  workspaceId String?
  type        TemplateType @default(USER)
  name        String
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)
  theme       Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sections  TemplateSection[]
  quotes    Quote[]

  @@index([userId])
  @@index([workspaceId])
  @@index([type])
}

model TemplateSection {
  id         String              @id @default(uuid())
  templateId String
  title      String
  type       TemplateSectionType
  position   Int
  meta       Json?

  template Template       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    TemplateItem[]

  @@index([templateId])
}

model TemplateItem {
  id        String           @id @default(uuid())
  sectionId String
  label     String
  value     String?
  type      TemplateItemType
  position  Int
  meta      Json?

  section TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model QuoteFolder {
  id              String   @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  color           String?
  icon            String?
  position        Int?
  isArchived      Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("QuoteFolderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  quotes    Quote[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([createdByUserId])
}

model Quote {
  id                    String        @id @default(uuid())
  userId                String
  workspaceId           String?
  folderId              String?
  templateId            String?
  status                QuoteStatus   @default(DRAFT)
  paymentStatus         PaymentStatus @default(PENDING)
  quoteNumber           String
  title                 String
  subtitle              String?
  description           String?
  clientData            Json
  eventData             Json?
  paymentData           Json?
  contactData           Json?
  logoUrl               String?       @map("logo_url")
  termsText             String?       @map("terms_text")
  senderProfileSnapshot Json?
  subtotal              Decimal       @db.Decimal(12, 2)
  discount              Decimal       @db.Decimal(12, 2)
  taxRate               Decimal       @db.Decimal(12, 2)
  netTotal              Decimal       @db.Decimal(12, 2)
  taxTotal              Decimal       @db.Decimal(12, 2)
  total                 Decimal       @db.Decimal(12, 2)
  issuedAt              DateTime
  validUntil            DateTime
  sentAt                DateTime?
  viewedAt              DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder        QuoteFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  template      Template?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sections      QuoteSection[]
  items         QuoteItem[]
  statusHistory QuoteStatusHistory[]
  favorites     QuoteFavorite[]

  @@unique([userId, quoteNumber])
  @@unique([workspaceId, quoteNumber])
  @@index([userId])
  @@index([workspaceId])
  @@index([folderId])
  @@index([templateId])
}

model QuoteFavorite {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  quoteId     String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([userId, quoteId])
  @@index([userId, workspaceId])
  @@index([quoteId])
}

model QuoteStatusHistory {
  id         String       @id @default(uuid())
  quoteId    String
  fromStatus QuoteStatus?
  toStatus   QuoteStatus
  changedBy  String?
  source     String       @default("INTERNAL")
  changedAt  DateTime     @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, changedAt])
}

model QuoteSection {
  id       String              @id @default(uuid())
  quoteId  String
  title    String
  type     TemplateSectionType
  position Int

  quote Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items QuoteSectionItem[]

  @@index([quoteId])
}

model QuoteSectionItem {
  id        String           @id @default(uuid())
  sectionId String
  label     String
  value     String?
  type      TemplateItemType
  position  Int

  section QuoteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  serviceId   String?
  title       String
  description String?
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  position    Int

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([serviceId])
}
