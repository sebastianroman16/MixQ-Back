generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PlanType {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum TemplateType {
  SYSTEM
  USER
}

enum TemplateSectionType {
  HEADER
  SUBTITLE
  CLIENT
  EVENT
  TABLE
  TOTALS
  TERMS
  PAYMENT
  CONTACT
}

enum TemplateItemType {
  TEXT
  FIELD
  TABLE_COLUMN
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  onboardingCompleted Boolean @default(false)
  plan                 PlanType @default(FREE)
  subscriptionStatus   SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  senderProfile SenderProfile?
  services      Service[]
  categories    Category[]
  templates     Template[]
  quotes        Quote[]
}

model SenderProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  displayName  String
  contactEmail String
  contactPhone String?
  address      String?
  addressLine  String?
  city         String?
  commune      String?
  logoUrl      String?
  legalName    String?
  rut          String?
  giro         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id          String   @id @default(uuid())
  userId      String
  inventoryCode String
  name        String
  description String?
  categoryId  String?
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quoteItems QuoteItem[]

  @@unique([userId, inventoryCode])
  @@index([userId])
  @@index([categoryId])
}

model Category {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([userId])
}

model Template {
  id        String        @id @default(uuid())
  userId    String?
  type      TemplateType  @default(USER)
  name      String
  isDefault Boolean       @default(false)
  isActive  Boolean       @default(true)
  theme     Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections TemplateSection[]
  quotes   Quote[]

  @@index([userId])
  @@index([type])
}

model TemplateSection {
  id         String             @id @default(uuid())
  templateId String
  title      String
  type       TemplateSectionType
  position   Int
  meta       Json?

  template Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    TemplateItem[]

  @@index([templateId])
}

model TemplateItem {
  id        String           @id @default(uuid())
  sectionId String
  label     String
  value     String?
  type      TemplateItemType
  position  Int
  meta      Json?

  section TemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model Quote {
  id          String      @id @default(uuid())
  userId      String
  templateId  String?
  status      QuoteStatus @default(DRAFT)
  quoteNumber String
  title       String
  subtitle    String?
  description String?
  clientData  Json
  eventData   Json?
  paymentData Json?
  contactData Json?
  logoUrl     String?     @map("logo_url")
  termsText   String?     @map("terms_text")
  senderProfileSnapshot Json?
  subtotal    Decimal     @db.Decimal(12, 2)
  discount    Decimal     @db.Decimal(12, 2)
  taxRate     Decimal     @db.Decimal(12, 2)
  netTotal    Decimal     @db.Decimal(12, 2)
  taxTotal    Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  issuedAt    DateTime
  validUntil  DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sections QuoteSection[]
  items    QuoteItem[]

  @@index([userId])
  @@unique([userId, quoteNumber])
  @@index([templateId])
}

model QuoteSection {
  id        String              @id @default(uuid())
  quoteId   String
  title     String
  type      TemplateSectionType
  position  Int

  quote Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  items QuoteSectionItem[]

  @@index([quoteId])
}

model QuoteSectionItem {
  id        String           @id @default(uuid())
  sectionId String
  label     String
  value     String?
  type      TemplateItemType
  position  Int

  section QuoteSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model QuoteItem {
  id          String   @id @default(uuid())
  quoteId     String
  serviceId   String?
  title       String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  position    Int

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([serviceId])
}
