# App
NODE_ENV="development"
PORT=3000
REQUEST_BODY_LIMIT="1mb"
TRUST_PROXY="false"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_KEEPALIVE_DELAY_MS=10000
PRISMA_CONNECT_RETRIES=3

# Auth
JWT_SECRET="change-me-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
# 12 is the minimum accepted cost; test this value against your deployment size.
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS="http://localhost:4200"

# Frontend base URL used for invitation links
FRONTEND_URL="http://localhost:4200"

# Mail (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="no-reply@mail.example.com"

# Billing / Flow
FLOW_API_KEY="flow_api_key"
FLOW_SECRET_KEY="flow_secret_key"
FLOW_API_BASE_URL="https://sandbox.flow.cl/api"
FLOW_CALLBACK_SECRET="change-me-with-a-long-random-secret"
BILLING_CRON_SECRET="change-me-with-a-long-random-secret"
PUBLIC_API_URL="http://localhost:3000"

# Optional local override for Puppeteer/Chrome executable path
PUPPETEER_EXECUTABLE_PATH=""
# Keep Chromium sandboxed. This may be set to true only for local development.
PUPPETEER_DISABLE_SANDBOX=false

# Remote URLs are deliberately disabled in PDF rendering to prevent SSRF.
# Use validated embedded image data URLs for logos and backgrounds.

# PDF rendering is resource-intensive. Requests beyond the queue limit return 503.
PDF_RENDER_CONCURRENCY=2
PDF_RENDER_MAX_QUEUE=20
