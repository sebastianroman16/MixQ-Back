# App
NODE_ENV="development"
PORT=3000

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_KEEPALIVE_DELAY_MS=10000
PRISMA_CONNECT_RETRIES=3

# Auth
JWT_SECRET="change-me-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# CORS
CORS_ORIGINS="http://localhost:4200"

# Frontend base URL used for invitation links
FRONTEND_URL="http://localhost:4200"

# Mail (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="no-reply@mail.example.com"

# Optional local override for Puppeteer/Chrome executable path
PUPPETEER_EXECUTABLE_PATH=""
