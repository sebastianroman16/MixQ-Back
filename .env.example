# App
NODE_ENV="development"
PORT=3000
REQUEST_BODY_LIMIT="1mb"
REQUEST_TIMEOUT_MS=60000
TRUST_PROXY="false"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# auto | disable | require | verify-ca | verify-full.
# Railway deployments should use auto; its public proxy uses require.
PG_SSL_MODE="require"
# Required for strict verification when the provider CA is not in the OS store.
# Accepts a PEM value with escaped newlines (\\n).
PG_SSL_CA=""
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_KEEPALIVE_DELAY_MS=10000
PRISMA_CONNECT_RETRIES=3

# E2E only: must point to a disposable database whose name contains "test".
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mixq_test"
TEST_PG_SSL_MODE="disable"

# Auth
JWT_SECRET="change-me-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_TTL_DAYS=30
# 12 is the minimum accepted cost; test this value against your deployment size.
BCRYPT_ROUNDS=12

# Bounded per-process dashboard cache (Redis can replace it when scaling out).
DASHBOARD_CACHE_MAX_ENTRIES=500

# CORS
CORS_ORIGINS="http://localhost:4200"

# Frontend base URL used for invitation links
FRONTEND_URL="http://localhost:4200"

# Mail (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="no-reply@mail.example.com"

# Billing / Flow
FLOW_API_KEY="flow_api_key"
FLOW_SECRET_KEY="flow_secret_key"
FLOW_API_BASE_URL="https://sandbox.flow.cl/api"
FLOW_CALLBACK_SECRET="change-me-with-a-long-random-secret"
BILLING_CRON_SECRET="change-me-with-a-long-random-secret"
PUBLIC_API_URL="http://localhost:3000"

# Optional local override for Puppeteer/Chrome executable path
PUPPETEER_EXECUTABLE_PATH=""
# Keep Chromium sandboxed. This may be set to true only for local development.
PUPPETEER_DISABLE_SANDBOX=false

# Staging smoke tests (do not use a production owner account).
SMOKE_BASE_URL="https://staging-api.example.com"
SMOKE_EMAIL="smoke-test@example.com"
SMOKE_PASSWORD="change-me"
SMOKE_REQUIRE_INTEGRATIONS=true
SMOKE_TIMEOUT_MS=15000

# Remote URLs are deliberately disabled in PDF rendering to prevent SSRF.
# Use validated embedded image data URLs for logos and backgrounds.

# PDF rendering is resource-intensive. Requests beyond the queue limit return 503.
PDF_RENDER_CONCURRENCY=2
PDF_RENDER_MAX_QUEUE=20
